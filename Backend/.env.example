# Server Port (optional, defaults to 8080)
PORT=8080

# Google Gemini API Key (Primary AI provider) — get yours at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional fallback) — get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# MySQL Configuration (Primary storage, viewable in MySQL Workbench)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=sigmagpt

# MongoDB connection string (Optional fallback storage)
# Local:  mongodb://localhost:27017/sigmagpt
# Atlas:  mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/sigmagpt
MONGODB_URI=mongodb://localhost:27017/sigmagpt

